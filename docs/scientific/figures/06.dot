digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.20", ranksep="0.26"];
node [shape=box,style="rounded,filled",color="#284755",fillcolor="#EDF5F5",fontname="DejaVu Sans",fontsize=11,margin="0.12,0.07"];
edge [color="#365767",fontcolor="#243B49",fontname="DejaVu Sans",fontsize=10,arrowsize=0.65];
n0 [label="Next model"];
n1 [label="Pending recordings?",shape=diamond,fillcolor="#FFF2D6"];
n2 [label="Open worker"];
n3 [label="Process pending recordings"];
n4 [label="Save each outcome in parent"];
n5 [label="Close session"];
n6 [label="Skip model"];
n0 -> n1;
n1 -> n2 [label="yes"];
n1 -> n6 [label="no"];
n2 -> n3;
n3 -> n4;
n3 -> n5 [label="finally"];
}
