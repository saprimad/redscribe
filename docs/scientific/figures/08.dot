digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.15", nodesep="0.20", ranksep="0.26"];
node [shape=box,style="rounded,filled",color="#284755",fillcolor="#EDF5F5",fontname="DejaVu Sans",fontsize=11,margin="0.12,0.07"];
edge [color="#365767",fontcolor="#243B49",fontname="DejaVu Sans",fontsize=10,arrowsize=0.65];
n0 [label="Read matrix identity"];
n1 [label="Identity matches?",shape=diamond,fillcolor="#FFF2D6"];
n2 [label="Reject resume"];
n3 [label="Verify completed cell"];
n4 [label="Reuse cell"];
n5 [label="Schedule pending work"];
n6 [label="Save outcome atomically"];
n0 -> n1;
n1 -> n2 [label="no"];
n1 -> n3 [label="yes"];
n3 -> n4 [label="verified"];
n3 -> n5 [label="other"];
n5 -> n6;
}
